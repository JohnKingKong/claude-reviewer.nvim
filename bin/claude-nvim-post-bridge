#!/bin/bash
# bin/claude-nvim-post-bridge
# PostToolUse hook: if the user edited Claude's proposed content during review,
# overwrite the file Claude just wrote with the user's version. Then, if a
# buffer for this file is open anywhere in Neovim, reload it - the write
# happens entirely outside Neovim's own event loop, so a buffer that was
# already open (and therefore reused rather than recreated) never notices
# the on-disk change on its own.

LOG_TAG="post-bridge"
# shellcheck source=claude-nvim-lib.sh
source "$(dirname "$0")/claude-nvim-lib.sh"

PAYLOAD=$(cat)
TOOL_NAME=$(payload_get "d.get('tool_name')")
RAW_FILE_PATH=$(payload_get "d.get('tool_input', {}).get('file_path')")
CLAUDE_CWD=$(payload_get "d.get('cwd')")
[ -n "$RAW_FILE_PATH" ] && FILE_PATH=$(abs_path "$RAW_FILE_PATH")

log "invoked: tool=$TOOL_NAME file=$FILE_PATH"

if [[ "$TOOL_NAME" != "Edit" && "$TOOL_NAME" != "Write" ]] || [ -z "$FILE_PATH" ]; then
  log "not an Edit/Write with a file_path, exiting"
  exit 0
fi

HASH=$(python3 -c "import hashlib, sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:8])" "$FILE_PATH")
PENDING="/tmp/claude-nvim-pending-${HASH}.txt"

if [ -f "$PENDING" ]; then
  cp "$PENDING" "$FILE_PATH"
  rm -f "$PENDING"
  log "applied your in-review modifications from $PENDING"
fi

# Same lookup as the main bridge, so the reload reaches the Neovim that
# showed the review.
if find_nvim_socket "$FILE_PATH" "$CLAUDE_CWD"; then
  nvim --server "$SOCKET" --remote-expr "luaeval(\"require('claude-reviewer').reload_buffer('$FILE_PATH')\")" >/dev/null 2>&1
  log "reload_buffer RPC sent via $SOCKET_SOURCE, exit=$?"
else
  log "no live Neovim found, nothing to reload"
fi

exit 0
