#!/bin/bash
# bin/claude-nvim-bridge

DEBUG_LOG="/tmp/claude-reviewer-debug.log"
log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') [bridge pid=$$] $1" >> "$DEBUG_LOG"
}

# 1. Read the JSON payload from Claude Code via stdin
PAYLOAD=$(cat)

# 2. Safely extract the tool name and file path using Python
TOOL_NAME=$(echo "$PAYLOAD" | python3 -c "import sys, json; print(json.load(sys.stdin).get('tool_name', ''))")
FILE_PATH=$(echo "$PAYLOAD" | python3 -c "import sys, json; print(json.load(sys.stdin).get('tool_input', {}).get('file_path', ''))")
FILE_PATH=$(realpath --canonicalize-missing "$FILE_PATH" 2>/dev/null || echo "$FILE_PATH")

log "invoked: tool=$TOOL_NAME file=$FILE_PATH NVIM_LISTEN_ADDRESS=${NVIM_LISTEN_ADDRESS:-<unset>} NVIM=${NVIM:-<unset>} CMUX_WORKSPACE_ID=${CMUX_WORKSPACE_ID:-<unset>}"

# If it's not Edit or Write, allow it to continue normally
if [[ "$TOOL_NAME" != "Edit" && "$TOOL_NAME" != "Write" ]]; then
  log "not Edit/Write, allowing without review"
  exit 0
fi

# 3. Find the Neovim socket for this specific workspace

SOCKET=""
SOCKET_SOURCE=""

# Priority 1: Claude is running inside a Neovim terminal — use that instance directly
if [ -n "$NVIM_LISTEN_ADDRESS" ]; then
  SOCKET="$NVIM_LISTEN_ADDRESS"
  SOCKET_SOURCE="NVIM_LISTEN_ADDRESS env var"
elif [ -n "$NVIM" ]; then
  SOCKET="$NVIM"
  SOCKET_SOURCE="NVIM env var"
fi

# Priority 2: Match by CMUX workspace — a workspace groups the panes for one
# task, so it's scoped tighter than "same repo" and won't hijack an unrelated
# nvim that just happens to be open elsewhere in the same monorepo.
if [ -z "$SOCKET" ] && [ -n "$CMUX_WORKSPACE_ID" ]; then
  CMUX_FILE="/tmp/claude-nvim-cmux-${CMUX_WORKSPACE_ID}.txt"
  if [ -f "$CMUX_FILE" ]; then
    SOCKET=$(cat "$CMUX_FILE")
    SOCKET_SOURCE="CMUX file $CMUX_FILE"
  fi
fi

# Priority 3: Match by cwd — fallback for when not running inside CMUX
if [ -z "$SOCKET" ]; then
  CLAUDE_CWD=$(echo "$PAYLOAD" | python3 -c "import sys, json; print(json.load(sys.stdin).get('cwd', ''))" 2>/dev/null)
  if [ -n "$CLAUDE_CWD" ]; then
    CWD_HASH=$(python3 -c "import hashlib, sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:8])" "$CLAUDE_CWD" 2>/dev/null)
    CWD_FILE="/tmp/claude-nvim-cwd-${CWD_HASH}.txt"
    log "trying cwd match: CLAUDE_CWD=$CLAUDE_CWD hash=$CWD_HASH file=$CWD_FILE exists=$([ -f "$CWD_FILE" ] && echo yes || echo no)"
    if [ -f "$CWD_FILE" ]; then
      SOCKET=$(cat "$CWD_FILE")
      SOCKET_SOURCE="cwd file $CWD_FILE (CLAUDE_CWD=$CLAUDE_CWD)"
    else
      # write_socket_file() also registers under the tab's git root, to
      # cover nvim being opened in a subdirectory. Mirror that here: Claude
      # itself may be running from a subdirectory (e.g. a monorepo package)
      # while the matching nvim tab is rooted at the repo root, so the exact
      # cwd hash alone would never match even though a real socket exists.
      GIT_ROOT=$(git -C "$CLAUDE_CWD" rev-parse --show-toplevel 2>/dev/null)
      if [ -n "$GIT_ROOT" ] && [ "$GIT_ROOT" != "$CLAUDE_CWD" ]; then
        GIT_ROOT_HASH=$(python3 -c "import hashlib, sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:8])" "$GIT_ROOT" 2>/dev/null)
        GIT_ROOT_FILE="/tmp/claude-nvim-cwd-${GIT_ROOT_HASH}.txt"
        log "trying git-root match: GIT_ROOT=$GIT_ROOT hash=$GIT_ROOT_HASH file=$GIT_ROOT_FILE exists=$([ -f "$GIT_ROOT_FILE" ] && echo yes || echo no)"
        if [ -f "$GIT_ROOT_FILE" ]; then
          SOCKET=$(cat "$GIT_ROOT_FILE")
          SOCKET_SOURCE="git-root file $GIT_ROOT_FILE (GIT_ROOT=$GIT_ROOT)"
        fi
      fi
    fi
  else
    log "no cwd in payload"
  fi
fi

log "resolved socket=${SOCKET:-<none>} source=${SOCKET_SOURCE:-<none>} is_valid_socket=$([ -S "$SOCKET" ] && echo yes || echo no)"

# No Neovim for this workspace — let Claude Code show its own permission UI
if [ -z "$SOCKET" ] || [ ! -S "$SOCKET" ]; then
  log "no valid socket, exiting 0 (Claude Code's own UI takes over)"
  exit 0
fi

# 4. Extract Claude's proposed code into a temporary file
NEW_CONTENT_FILE=$(mktemp)
if [[ "$TOOL_NAME" == "Write" ]]; then
  echo "$PAYLOAD" | python3 -c "import sys, json; print(json.load(sys.stdin).get('tool_input', {}).get('content', ''))" >"$NEW_CONTENT_FILE"
else
  # Edit only gives old_string/new_string (a fragment), not the full file. Diffing
  # the full original against just that fragment misaligns line numbers and can
  # make diff show the whole left buffer as deleted. Reconstruct the full
  # post-edit content by applying the substitution to the current file, so both
  # sides of the diff are full files.
  echo "$PAYLOAD" | python3 -c "
import sys, json

data = json.load(sys.stdin)
tool_input = data.get('tool_input', {})
old_string = tool_input.get('old_string', '')
new_string = tool_input.get('new_string', '')
replace_all = tool_input.get('replace_all', False)

path = sys.argv[1]
try:
    with open(path, 'r') as f:
        content = f.read()
except OSError:
    content = ''

if replace_all:
    content = content.replace(old_string, new_string)
else:
    content = content.replace(old_string, new_string, 1)

sys.stdout.write(content)
" "$FILE_PATH" >"$NEW_CONTENT_FILE"
fi

# 5. Create temp files: status (nvim writes decision) + alive (holds bridge PID for liveness check)
STATUS_FILE=$(mktemp)
ALIVE_FILE=$(mktemp)
echo "$$" > "$ALIVE_FILE"
trap 'rm -f "$ALIVE_FILE" "$NEW_CONTENT_FILE" "$STATUS_FILE"' EXIT

# 6. Send to running Neovim via RPC
RPC_OUTPUT=$(nvim --server "$SOCKET" --remote-expr "luaeval(\"require('claude-reviewer').start_review('$FILE_PATH', '$NEW_CONTENT_FILE', '$STATUS_FILE', '$ALIVE_FILE')\")" 2>&1)
RPC_EXIT=$?
log "RPC sent to $SOCKET, exit=$RPC_EXIT output=${RPC_OUTPUT:-<empty>}"

# 7. Wait for the user to approve or deny in Neovim (timeout after 5 minutes)
TIMEOUT=300
ELAPSED=0
while [ ! -s "$STATUS_FILE" ]; do
  sleep 0.5
  ELAPSED=$((ELAPSED + 1))
  if [ "$ELAPSED" -ge "$((TIMEOUT * 2))" ]; then
    log "timed out waiting for status_file"
    rm -f "$NEW_CONTENT_FILE" "$STATUS_FILE"
    echo '{"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": {"behavior": "deny", "message": "Review timed out."}}}'
    exit 2
  fi
done

RESULT=$(cat "$STATUS_FILE")
log "status_file result=$RESULT"

# 8. Read decision and respond directly to Claude Code's permission engine
if [ "$RESULT" = "2" ]; then
  echo '{"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": {"behavior": "deny", "message": "Edit rejected by user in Neovim."}}}'
  exit 2
elif [ "$RESULT" = "3" ]; then
  # start_review() found a live nvim instance for this cwd/git-root/CMUX
  # socket, but no *open tab* whose own directory actually covers this file
  # (e.g. edit is for a workspace that isn't currently open). Decline rather
  # than opening a tab for a workspace that doesn't exist: behave exactly
  # like "no nvim instance found" so Claude Code's own default permission UI
  # takes over.
  exit 0
else
  echo '{"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": {"behavior": "allow"}}}'
  exit 0
fi
