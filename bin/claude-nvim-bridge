#!/bin/bash
# bin/claude-nvim-bridge
#
# Claude Code PreToolUse hook for Edit/Write. PreToolUse (unlike
# PermissionRequest) runs before any permission UI exists and the tool cannot
# run until this script returns, so the review can't be raced or bypassed by
# whatever else is listening: Claude Code's own prompt, a terminal's
# integration (e.g. cmux injects its own PermissionRequest hook), or another
# plugin. That's what makes this work the same from any terminal.
#
# Outcomes:
#   approved in Neovim  -> permissionDecision "allow" (no Claude prompt shown)
#   rejected in Neovim  -> permissionDecision "deny"
#   no Neovim / no tab  -> no output: Claude Code's normal permission flow runs

LOG_TAG="bridge"
# shellcheck source=claude-nvim-lib.sh
source "$(dirname "$0")/claude-nvim-lib.sh"

PAYLOAD=$(cat)

decide() { # decide <allow|deny> [reason]
  python3 -c "import json, sys
out = {'hookEventName': 'PreToolUse', 'permissionDecision': sys.argv[1]}
if len(sys.argv) > 2:
    out['permissionDecisionReason'] = sys.argv[2]
print(json.dumps({'hookSpecificOutput': out}))" "$@"
  exit 0
}

TOOL_NAME=$(payload_get "d.get('tool_name')")
RAW_FILE_PATH=$(payload_get "d.get('tool_input', {}).get('file_path')")
CLAUDE_CWD=$(payload_get "d.get('cwd')")
[ -n "$RAW_FILE_PATH" ] && FILE_PATH=$(abs_path "$RAW_FILE_PATH")

log "invoked: tool=$TOOL_NAME file=$FILE_PATH cwd=$CLAUDE_CWD NVIM=${NVIM:-<unset>} CMUX_WORKSPACE_ID=${CMUX_WORKSPACE_ID:-<unset>}"

if [[ "$TOOL_NAME" != "Edit" && "$TOOL_NAME" != "Write" ]] || [ -z "$FILE_PATH" ]; then
  log "not an Edit/Write with a file_path, passing through"
  exit 0
fi

if ! find_nvim_socket "$FILE_PATH" "$CLAUDE_CWD"; then
  log "no live Neovim found, passing through to Claude Code's own permission flow"
  exit 0
fi
log "resolved socket=$SOCKET via $SOCKET_SOURCE"

NEW_CONTENT_FILE=$(mktemp)
STATUS_FILE=$(mktemp)
ALIVE_FILE=$(mktemp)
# Neovim polls this PID: if Claude Code kills the hook (Esc / interrupt), the
# trap removes the file and the diff closes itself.
echo "$$" > "$ALIVE_FILE"
trap 'rm -f "$ALIVE_FILE" "$NEW_CONTENT_FILE" "$STATUS_FILE"' EXIT

if [[ "$TOOL_NAME" == "Write" ]]; then
  payload_get "d.get('tool_input', {}).get('content', '')" > "$NEW_CONTENT_FILE"
else
  # Edit only carries an old_string/new_string fragment. Rebuild the full
  # post-edit file so both sides of the diff are complete files.
  printf '%s' "$PAYLOAD" | python3 -c "
import sys, json
ti = json.load(sys.stdin).get('tool_input', {})
old, new = ti.get('old_string', ''), ti.get('new_string', '')
try:
    with open(sys.argv[1]) as f:
        content = f.read()
except OSError:
    content = ''
if old not in content:
    sys.exit(3)  # Claude's Edit will fail on its own; nothing to review
count = -1 if ti.get('replace_all') else 1
sys.stdout.write(content.replace(old, new, count))
" "$FILE_PATH" > "$NEW_CONTENT_FILE"
  if [ $? -eq 3 ]; then
    log "old_string not found in file, passing through (the Edit will fail by itself)"
    exit 0
  fi
fi

RPC_OUTPUT=$(nvim --server "$SOCKET" --remote-expr "luaeval(\"require('claude-reviewer').start_review('$FILE_PATH', '$NEW_CONTENT_FILE', '$STATUS_FILE', '$ALIVE_FILE')\")" 2>&1)
RPC_EXIT=$?
log "RPC sent, exit=$RPC_EXIT output=${RPC_OUTPUT:-<empty>}"
if [ "$RPC_EXIT" -ne 0 ]; then
  log "RPC failed, passing through"
  exit 0
fi

# Wait for the decision (30 minutes; the hook entry's own timeout in
# settings.json is set to match, see setup() in init.lua).
TIMEOUT_TICKS=$((1800 * 2))
TICKS=0
while [ ! -s "$STATUS_FILE" ]; do
  sleep 0.5
  TICKS=$((TICKS + 1))
  if [ "$TICKS" -ge "$TIMEOUT_TICKS" ]; then
    log "timed out waiting for a decision"
    decide deny "Review in Neovim timed out."
  fi
done

RESULT=$(cat "$STATUS_FILE")
log "decision=$RESULT"

case "$RESULT" in
  0) decide allow "Approved in Neovim." ;;
  2) decide deny "Edit rejected by user in Neovim." ;;
  *)
    # 3: Neovim is running but no open tab covers this file. Behave as if no
    # Neovim were found, so Claude Code's own permission flow takes over.
    exit 0
    ;;
esac
